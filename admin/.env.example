PORT=3000
# Configure HTTPS no proxy e defina em produção:
NODE_ENV=production
# Opcional: caminho absoluto do SQLite
# DB_PATH=/var/lib/hitchhike/admin.sqlite
# Caminho absoluto do JSON da conta de serviço do projeto hitchhike-9568f.
# Baixe no Firebase Console, em Configurações do projeto > Contas de serviço.
# Guarde o arquivo fora desta pasta. Não cole a chave neste arquivo.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/Users/isabe/secrets/hitchhike-9568f-firebase-adminsdk.json

# --- Armazenamento privado de PDFs da CNH ---
# Chave exclusiva de 32 bytes (64 caracteres hexadecimais ou Base64) usada para criptografar os PDFs
# com AES-256-GCM em repouso. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Não utilize chave padrão, não reutilize segredos do Mercado Pago e nunca versione a chave no Git.
# CNH_STORAGE_KEY=
# Opcional: diretório privado (fora de public/) onde os PDFs criptografados (.pdf.enc) são gravados.
# CNH_STORAGE_DIR=data/cnh_pdfs


# --- Pagamentos de TESTE (Mercado Pago Checkout Pro) ---
# Somente credenciais de TESTE da conta vendedora de teste. Nunca use credenciais de produção.
# Defina os valores no ambiente (.env local, ignorado pelo Git, ou painel do Render), nunca neste arquivo.
# MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta exibida em Suas integrações > Webhooks > Configurar notificações (assinatura secreta).
# MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS do backend (sem barra no final). Sem ela, o webhook e as URLs de retorno não são enviados ao Mercado Pago.
# PUBLIC_BASE_URL=
# Opcional: init_point (padrão) ou sandbox_init_point. Veja docs/PAGAMENTOS.md.
# MERCADOPAGO_CHECKOUT_URL=init_point

# --- Split 1:1 (Mercado Pago) - DESLIGADO por padrao, somente TESTE ---
# So habilite apos configurar tudo abaixo. Valores reais ficam no .env local (ignorado pelo Git) ou no painel de hospedagem.
# MERCADOPAGO_SPLIT_ENABLED=false
# Tarifa Mercado Pago ESTIMADA em % (ex.: confira na sua conta de teste). NAO e valor garantido; sem ela o split nao liga.
# MERCADOPAGO_TARIFA_PIX_PERCENT=
# Restringe o checkout a Pix (padrao true). Use false apenas para demonstracoes em sandbox; a estimativa de tarifa deixa de valer.
# MERCADOPAGO_SPLIT_SOMENTE_PIX=true
# Credenciais da APLICACAO (painel Mercado Pago Developers > Suas integracoes). Nunca no app Android nem no GitHub.
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
# Mesma URL cadastrada como Redirect URL da aplicacao (HTTPS): PUBLIC_BASE_URL + /api/mercadopago/oauth/callback
# MERCADOPAGO_REDIRECT_URI=
# Chave de 32 bytes (64 caracteres hex) para cifrar tokens no SQLite. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MERCADOPAGO_TOKEN_KEY=
