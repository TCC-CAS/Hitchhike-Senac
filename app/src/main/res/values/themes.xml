<resources>
    <style name="Base.Theme.Hitchhike" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hh_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/hh_mint</item>
        <item name="colorOnPrimaryContainer">@color/hh_green_dark</item>
        <item name="colorSecondary">@color/hh_green_light</item>
        <item name="colorSurface">@color/hh_surface</item>
        <item name="colorOnSurface">@color/hh_text</item>
        <item name="android:statusBarColor">@color/hh_green_dark</item>
        <item name="android:navigationBarColor">@color/hh_background</item>
        <item name="android:windowBackground">@color/hh_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/hh_text</item>
        <item name="materialButtonStyle">@style/Widget.Hitchhike.Button</item>
    </style>

    <style name="Theme.Hitchhike" parent="Base.Theme.Hitchhike" />

    <style name="Widget.Hitchhike.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/hh_button_min</item>
        <item name="android:minWidth">@dimen/hh_touch_min</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="Widget.Hitchhike.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/hh_button_min</item>
        <item name="android:minWidth">@dimen/hh_touch_min</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/hh_green</item>
        <item name="android:textColor">@color/hh_green</item>
    </style>

    <style name="Widget.Hitchhike.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/hh_touch_min</item>
        <item name="android:minWidth">@dimen/hh_touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/hh_green</item>
    </style>

    <style name="Widget.Hitchhike.Button.Back" parent="Widget.Material3.Button">
        <item name="android:minWidth">@dimen/hh_touch_min</item>
        <item name="android:minHeight">@dimen/hh_touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:contentDescription">@string/cd_voltar</item>
        <item name="backgroundTint">@color/hh_green</item>
        <item name="cornerRadius">12dp</item>
        <item name="icon">@drawable/ic_arrow_back</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="TextAppearance.Hitchhike.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/hh_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Hitchhike.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/hh_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Hitchhike.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/hh_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
