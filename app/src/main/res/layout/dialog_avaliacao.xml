<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/avaliacao_instrucao"
        android:textColor="@color/hh_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/estrela1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/hh_green"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/estrela2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/hh_green"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/estrela3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/hh_green"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/estrela4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/hh_green"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/estrela5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="☆"
            android:textColor="@color/hh_green"
            android:textSize="32sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNotaSelecionada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/hh_text"
        android:textStyle="bold" />
</LinearLayout>
