<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvParticipanteNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hh_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvParticipantePapel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/hh_text_secondary" />

    <TextView
        android:id="@+id/tvParticipanteReputacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/hh_text_secondary" />

    <TextView
        android:id="@+id/tvParticipanteAvaliada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/avaliacao_enviada"
        android:textColor="@color/hh_green"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnParticipanteAvaliar"
        style="@style/Widget.Hitchhike.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/action_avaliar"
        android:visibility="gone" />
</LinearLayout>
