<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPassageiro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hh_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatusPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/hh_text_secondary" />

    <LinearLayout
        android:id="@+id/acoesPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAceitar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/action_aceitar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecusar"
            style="@style/Widget.Hitchhike.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_recusar"
            android:textColor="@color/hh_error" />
    </LinearLayout>
</LinearLayout>
