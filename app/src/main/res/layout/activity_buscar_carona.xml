<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBuscar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hh_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/hh_screen_padding"
                android:paddingTop="@dimen/hh_screen_padding"
                android:paddingEnd="@dimen/hh_screen_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/hh_content_max">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoltar"
                    style="@style/Widget.Hitchhike.Button.Back"
                    android:layout_width="@dimen/hh_touch_min"
                    android:layout_height="@dimen/hh_touch_min"
                    android:layout_marginBottom="@dimen/hh_space_sm" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/buscar_title"
                    android:textAppearance="@style/TextAppearance.Hitchhike.Title" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOrigem"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/hint_origem">

                    <AutoCompleteTextView
                        android:id="@+id/etOrigem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="150"
                        android:minHeight="@dimen/hh_button_min" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDestino"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/hint_destino">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDestino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="150"
                        android:minHeight="@dimen/hh_button_min"
                        android:text="@string/destino_padrao" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/action_buscar" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/hh_screen_padding"
                android:paddingEnd="@dimen/hh_screen_padding"
                android:paddingBottom="@dimen/hh_screen_padding">

                <LinearLayout
                    android:id="@+id/listaCaronas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/tvVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/hh_screen_padding"
                android:text="@string/buscar_vazio"
                android:textAppearance="@style/TextAppearance.Hitchhike.Subtitle"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBuscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/estado_carregando"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
